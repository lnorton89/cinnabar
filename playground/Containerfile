# The playground image: the compiler, a small API, and nothing else.
#
# Two stages. The first builds the compiler against LLVM 21; the second is
# the runtime, which carries the compiler, the linker and headers a build
# needs, Node for the API, and no build toolchain of its own.
#
# The container is where a submission is actually contained. The API's caps
# on size, time and concurrency are necessary but they do not constrain what
# a program can *do* — only the runtime does that, and only with the options
# in compose.playground.yaml applied. See README.md.

FROM docker.io/library/rust:1-bookworm AS build

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates gnupg lsb-release wget \
 && wget -qO /usr/share/keyrings/llvm.asc https://apt.llvm.org/llvm-snapshot.gpg.key \
 && echo "deb [signed-by=/usr/share/keyrings/llvm.asc] http://apt.llvm.org/bookworm/ llvm-toolchain-bookworm-21 main" \
      > /etc/apt/sources.list.d/llvm21.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends llvm-21-dev libpolly-21-dev clang-21 lld-21 \
      libzstd-dev libxml2-dev libffi-dev zlib1g-dev \
 && rm -rf /var/lib/apt/lists/*

ENV LLVM_SYS_211_PREFIX=/usr/lib/llvm-21
ENV PATH=/usr/lib/llvm-21/bin:$PATH

WORKDIR /src
COPY Cargo.toml Cargo.lock build.rs ./
COPY src ./src
COPY crates ./crates
COPY tests ./tests
RUN cargo build --release --bin cinnabar

FROM docker.io/library/debian:bookworm-slim AS runtime

# `llc` and `clang` are not developer conveniences here: they are stages of
# a Cinnabar build, invoked by the compiler itself to assemble and link.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates gnupg wget \
 && wget -qO /usr/share/keyrings/llvm.asc https://apt.llvm.org/llvm-snapshot.gpg.key \
 && echo "deb [signed-by=/usr/share/keyrings/llvm.asc] http://apt.llvm.org/bookworm/ llvm-toolchain-bookworm-21 main" \
      > /etc/apt/sources.list.d/llvm21.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends llvm-21 clang-21 nodejs \
 && rm -rf /var/lib/apt/lists/* \
 && ln -s /usr/lib/llvm-21/bin/llc /usr/local/bin/llc \
 && ln -s /usr/bin/clang-21 /usr/local/bin/clang

COPY --from=build /src/target/release/cinnabar /usr/local/bin/cinnabar
COPY playground/server /srv/server
COPY playground/web/dist /srv/web

# Never root. The runtime options in the Compose file drop every capability
# on top of this, but an image that would run as root without them is one
# bad deployment away from having none of that protection.
RUN useradd --system --create-home --home-dir /home/playground --shell /usr/sbin/nologin playground
USER playground

ENV CINNABAR_BIN=/usr/local/bin/cinnabar
ENV PLAYGROUND_STATIC_ROOT=/srv/web
ENV NODE_ENV=production
ENV PORT=8080
EXPOSE 8080

CMD ["node", "/srv/server/src/main.js"]
