{
  "name": "cinnabar-language-support",
  "displayName": "Cinnabar Language Support",
  "description": "Syntax highlighting, attached-facts language-server support, project tasks, and a borrow-explanation view for Cinnabar.",
  "version": "0.1.0",
  "publisher": "cinnabar-lang",
  "license": "Apache-2.0 WITH LLVM-exception",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "icon": "icon.png",
  "main": "./extension.js",
  "files": [
    "extension.js",
    "lsp-launcher.js",
    "tasks.js",
    "explanation.js",
    "language-configuration.json",
    "syntaxes",
    "snippets",
    "icon.png",
    "README.md",
    "LICENSE",
    "node_modules"
  ],
  "scripts": {
    "test": "node --test",
    "package:dry-run": "npx --yes @vscode/vsce ls --tree"
  },
  "contributes": {
    "languages": [
      {
        "id": "cinnabar",
        "aliases": [
          "Cinnabar",
          "cinnabar"
        ],
        "extensions": [
          ".cnb"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cinnabar",
        "scopeName": "source.cinnabar",
        "path": "./syntaxes/cinnabar.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "cinnabar",
        "path": "./snippets/cinnabar.json"
      }
    ],
    "commands": [
      {
        "command": "cinnabar.restartServer",
        "title": "Cinnabar: Restart Language Server"
      },
      {
        "command": "cinnabar.showOutputChannel",
        "title": "Cinnabar: Show Output Channel"
      }
    ],
    "configuration": {
      "title": "Cinnabar",
      "properties": {
        "cinnabar.server.mode": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "installed",
            "path",
            "docker-compose"
          ],
          "enumDescriptions": [
            "Use cinnabar.server.path when it is set; otherwise run cinnabar-lsp from PATH.",
            "Always run cinnabar-lsp from PATH.",
            "Run the executable configured in cinnabar.server.path.",
            "Run the repository development server through Docker Compose."
          ],
          "description": "Selects how the Cinnabar Language Server is launched."
        },
        "cinnabar.server.path": {
          "type": "string",
          "default": "",
          "description": "Path to the cinnabar-lsp executable used by auto mode when set, or required by path mode."
        },
        "cinnabar.compiler.path": {
          "type": "string",
          "default": "cinnabar",
          "description": "The cinnabar executable the contributed build/run/check/test tasks invoke."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "cinnabar",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The Cinnabar project command this task runs.",
            "enum": [
              "build",
              "run",
              "check",
              "test",
              "test (update snapshots)"
            ]
          }
        }
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  }
}
